const SHEET_NAME='Students', MASTER_SHEET_NAME='MasterStudents';
const M5_STUDENTS=[[1,"01453","นายเจษฎากร พร้อมพรม",""],[2,"01455","นายณรงค์ กิ่มเกลี้ยง",""],[3,"01458","นายธีรเมธ ประรักฝักฝ่าย",""],[4,"01459","นายธีรศักดิ์ ศรกิจ",""],[5,"01460","นายปวริศ โนนสังข์",""],[6,"01461","นาย ปัณณพัฒน์ ผสมวงค์",""],[7,"01462","นายปิยะวัฒน์ ตัญญาภักดิ์",""],[8,"01463","นายพลรภัฏ บัวจูม",""],[9,"01594","นาย พิสิษฐ์ พิละ","แขวนลอย"],[10,"01464","นายพีรพัฒน์ วงสะกุล",""],[11,"01595","นายวีรศักดิ์ เข้าเมือง",""],[12,"01466","นายสมพร จันทรเส",""],[13,"01468","นายสุริยา ชาลี",""],[14,"01472","นางสาวชนิษา วงค์สุธา",""],[15,"01474","นางสาวธิชานัน พรพันธ์",""],[16,"01476","นางสาวพรนภา เขียวอ่อน",""],[17,"01571","นางสาวภาวิณี ใจภักดี",""],[18,"01570","นางสาววรกานต์ ชูเลิศ",""],[19,"01478","นางสาววรัญญา วงษา",""],[20,"01479","นางสาววรินยุพา อินมูล",""],[21,"01480","นางสาววัลยา พรมดี",""],[22,"01481","นางสาวศิริประภา สิทธิปกรณ์",""],[23,"01482","นางสาว ศิริลักษณ์ วงษา","แขวนลอย"],[24,"01483","นางสาวศุภิสรา ทองขาว",""],[25,"01484","นางสาวสุจิตรา หัสดง",""],[26,"01596","นางสาวสุรารักษ์ สืบเคน",""]];
const M5=M5_STUDENTS.map(r=>{const full=r[2], prefix=full.startsWith('นาย')?'นาย':'นางสาว', rest=full.replace(/^นาย\s*|^นางสาว\s*/,'').trim(), parts=rest.split(/\s+/); return [r[0],r[1],full,prefix,parts[0]||'',parts.slice(1).join(' '),r[3]||''];});
function doGet(e){const p=e&&e.parameter?e.parameter:{},cb=p.callback||'';let result;try{result=handleRequest_(p)}catch(err){result={ok:false,error:String(err&&err.message?err.message:err)}}const j=JSON.stringify(result);return ContentService.createTextOutput(cb?cb+'('+j+')':j).setMimeType(cb?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON)}
function doPost(e){let p={};try{p=JSON.parse((e&&e.postData&&e.postData.contents)||'{}')}catch(_){}return ContentService.createTextOutput(JSON.stringify(handleRequest_(p))).setMimeType(ContentService.MimeType.JSON)}
function setupDatabase(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME)||ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0){sh.getRange(1,1,1,11).setValues([['id','grade','studentNumber','phone','prefix','firstname','lastname','status','reason','timestamp','updatedAt']]);sh.setFrozenRows(1)}let m=ss.getSheetByName(MASTER_SHEET_NAME)||ss.insertSheet(MASTER_SHEET_NAME);if(m.getLastRow()===0){m.getRange(1,1,1,7).setValues([['studentNumber','studentId','fullName','prefix','firstname','lastname','note']]);m.getRange(2,1,M5.length,7).setValues(M5);m.setFrozenRows(1);m.getRange('A:B').setNumberFormat('@')}return sh}
function handleRequest_(p){const sh=setupDatabase(),a=String(p.action||'list').toLowerCase();if(a==='students')return{ok:true,data:readMaster_()};if(a==='list')return{ok:true,data:readAll_(sh)};if(a==='save'){const id=Utilities.getUuid(),now=new Date().toISOString();sh.appendRow([id,p.grade||'ม.5',p.studentNumber||'',p.phone||'',p.prefix||'',p.firstname||'',p.lastname||'',p.status||'ไป',p.reason||'-',p.timestamp||now,now]);return{ok:true,id:id}}if(a==='update'){const id=String(p.id||''),row=findRow_(sh,id);if(!row)return{ok:false,error:'ไม่พบข้อมูล'};const now=new Date().toISOString();sh.getRange(row,1,1,11).setValues([[id,p.grade||'ม.5',p.studentNumber||'',p.phone||'',p.prefix||'',p.firstname||'',p.lastname||'',p.status||'ไป',p.reason||'-',p.timestamp||now,now]]);return{ok:true,id:id}}if(a==='delete'){const row=findRow_(sh,String(p.id||''));if(!row)return{ok:false,error:'ไม่พบข้อมูล'};sh.deleteRow(row);return{ok:true}}return{ok:false,error:'Unknown action: '+a}}
function readMaster_(){const s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(MASTER_SHEET_NAME);if(!s||s.getLastRow()<2)return[];return s.getRange(2,1,s.getLastRow()-1,7).getValues().filter(r=>r[0]||r[2]).map(r=>({studentNumber:String(r[0]||''),studentId:String(r[1]||''),fullName:String(r[2]||''),prefix:String(r[3]||''),firstname:String(r[4]||''),lastname:String(r[5]||''),note:String(r[6]||'')}))}
function readAll_(s){const v=s.getDataRange().getValues();if(v.length<=1)return[];const h=v[0];return v.slice(1).filter(r=>r[0]).map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i]);return o})}
function findRow_(s,id){if(!id||s.getLastRow()<2)return null;const v=s.getRange(2,1,s.getLastRow()-1,1).getValues();for(let i=0;i<v.length;i++)if(String(v[i][0])===id)return i+2;return null}